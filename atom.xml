---
layout: null
permalink: /atom.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | strip_html | xml_escape }}</subtitle>
  <link href="{{ site.url }}{{ site.baseurl }}/atom.xml" rel="self"/>
  <link href="{{ site.url }}{{ site.baseurl }}/"/>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.data.authors.newsdesk.name | default: site.default_author.name | xml_escape }}</name>
    <email>{{ site.data.authors.newsdesk.email | default: site.email }}</email>
    <uri>{{ site.url }}{{ site.baseurl }}{{ site.data.authors.newsdesk.url | default: '/author/f9xr/' }}</uri>
  </author>
  {% for post in site.posts limit: 20 %}
  {% assign atom_slug = post.author | default: 'newsdesk' %}{% assign atom_author = site.data.authors[atom_slug] | default: site.data.authors.newsdesk %}
  {% assign atom_img = post.cover_image | default: post.image | default: site.image %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ site.baseurl }}{{ post.url }}" rel="alternate"/>
    <id>{{ site.url }}{{ site.baseurl }}{{ post.url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <author>
      <name>{{ atom_author.name | xml_escape }}</name>
      <email>{{ atom_author.email | default: site.email }}</email>
      <uri>{{ site.url }}{{ site.baseurl }}{{ atom_author.url | default: '/author/f9xr/' }}</uri>
    </author>
    <category term="{{ post.categories | first | default: 'news' }}"/>
    <summary>{{ post.description | default: post.excerpt | strip_html | xml_escape }}</summary>
    {% assign atom_img_abs = atom_img | absolute_url %}
    <media:content url="{{ atom_img_abs }}" medium="image" type="image/{{ atom_img | downcase | split: '.' | last | xml_escape }}"/>
    {% if post.image_alt %}<media:description type="plain">{{ post.image_alt | xml_escape }}</media:description>{% endif %}
    <content type="html"><![CDATA[{{ post.content }}]]></content>
  </entry>
  {% endfor %}
</feed>