---
layout: null
permalink: /atom.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | strip_html | xml_escape }}</subtitle>
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="self"/>
  <link href="{{ site.url }}{{ site.baseurl }}/"/>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.default_author.name | xml_escape }}</name>
    <email>{{ site.email }}</email>
    <uri>{{ site.url }}{{ site.baseurl }}/author/f9xr/</uri>
  </author>
  {% for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ site.baseurl }}{{ post.url }}" rel="alternate"/>
    <id>{{ site.url }}{{ site.baseurl }}{{ post.url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | default: post.excerpt | strip_html | xml_escape }}</summary>
    <category term="{{ post.categories | first | default: 'news' }}"/>
  </entry>
  {% endfor %}
</feed>
